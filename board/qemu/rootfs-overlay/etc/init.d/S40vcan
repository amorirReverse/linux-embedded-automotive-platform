#!/bin/sh

case "$1" in
    start)
        if ! ip link show vcan0 >/dev/null 2>&1; then
            ip link add dev vcan0 type vcan || exit 1
        fi
        ip link set vcan0 up
        ;;
    stop)
        ip link delete vcan0 2>/dev/null
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0